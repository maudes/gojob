# Copy this file to .env.local and fill in your key. It stays on your machine
# and is only read by the server, never sent to the browser.
ANTHROPIC_API_KEY=

# Optional overrides
# MAIN_MODEL=claude-opus-5-5        # writes the assessments and drafts
# REVIEWER_MODEL=claude-haiku-5-5   # the five lightweight fidelity auditors

# Reading job links: when a page cannot be read directly, the link is sent to
# Jina Reader (r.jina.ai), a third-party service. Set to "off" to never do that.
# JD_READER_FALLBACK=off
# JINA_API_KEY=
