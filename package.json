{
  "name": "gojob",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:web": "next dev -p 3210",
    "dev:api": "cd backend && uv run uvicorn gojob.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "next build",
    "start": "sh scripts/start.sh",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:web && npm run test:api",
    "test:web": "node --test lib/*.test.ts",
    "test:api": "cd backend && uv run pytest",
    "eval": "cd backend && uv run python ../evals/run.py"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
